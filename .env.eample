# Porta onde o site vai rodar
PORT=3000

# Firebase - baixe o JSON da conta de servico em:
# Firebase Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=seu-projeto-id

# Nome da colecao no Firestore onde as transacoes serao salvas
FIRESTORE_COLLECTION=transacoes

# Pluggy (Open Finance) - crie sua conta gratuita em https://meu.pluggy.ai
# As credenciais de API ficam disponiveis no dashboard depois de conectar suas contas
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui

# IDs dos "itens" (contas conectadas) que voce quer sincronizar.
# Cada conta/cartao conectado no Meu Pluggy gera um itemId - separe por virgula se tiver mais de uma.
PLUGGY_ITEM_IDS=

# De quantos em quantos minutos o servidor verifica novas transacoes automaticamente
SYNC_INTERVAL_MINUTOS=30
